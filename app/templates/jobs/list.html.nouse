{% extends "base.html" %}

{% block content %}

<h1>Jobs</h1>

{% if error %}
<div class="alert error">
    {{ error }}
</div>
{% endif %}

<table>
    <thead>
        <tr>
            <th>Job ID</th>
            <th>User</th>
            <th>Partition</th>
            <th>Name</th>
            <th>State</th>
            <th>Elapsed</th>
            <th>Nodes</th>
            <th>Reason</th>
        </tr>
    </thead>

    <tbody>
    {% for job in jobs %}
        <tr>
            <td>{{ job.job_id }}</td>
            <td>{{ job.user }}</td>
            <td>{{ job.partition }}</td>
            <td>{{ job.name }}</td>
            <td>{{ job.state }}</td>
            <td>{{ job.elapsed }}</td>
            <td>{{ job.nodes }}</td>
            <td>{{ job.reason }}</td>
        </tr>
    {% empty %}
        <tr>
            <td colspan="8">No jobs found.</td>
        </tr>
    {% endfor %}
    </tbody>
</table>

{% endblock %}

