{% load static %}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        {% block title %}Slurm Manager{% endblock %}
    </title>

    <link
        rel="stylesheet"
        href="{% static 'dashboard/dashboard.css' %}"
    >

    {% block extra_css %}{% endblock %}
</head>


<body>

<div class="app">

    <!-- =====================================================
         Top Navigation
         ===================================================== -->

    <header class="topbar">

        <div class="brand">
            Slurm Manager
        </div>

        <nav class="main-nav">

            <a
                href="{% url 'dashboard:index' %}"
                class="{% block nav_dashboard %}{% endblock %}"
            >
                Dashboard
            </a>

            <a
                href="{% url 'nodes:list' %}"
                class="{% block nav_nodes %}{% endblock %}"
            >
                Nodes
            </a>

            <a
                href="{% url 'partitions:list' %}"
                class="{% block nav_partitions %}{% endblock %}"
            >
                Partitions
            </a>

            <a
                href="{% url 'jobs:list' %}"
                class="{% block nav_jobs %}{% endblock %}"
            >
                Jobs
            </a>

        </nav>

    </header>


    <!-- =====================================================
         Main Content
         ===================================================== -->

    <main class="page">

        {% block content %}
        {% endblock %}

    </main>

</div>

</body>
</html>

