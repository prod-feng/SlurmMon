{% extends "base.html" %}

{% block content %}

<h1>Partitions</h1>

{% if error %}
<div class="alert error">
    {{ error }}
</div>
{% endif %}

<table>
    <thead>
        <tr>
            <th>Partition</th>
            <th>Availability</th>
            <th>Time Limit</th>
            <th>Nodes</th>
            <th>CPUs</th>
        </tr>
    </thead>

    <tbody>
    {% for partition in partitions %}
        <tr>
            <td>{{ partition.name }}</td>
            <td>{{ partition.availability }}</td>
            <td>{{ partition.time_limit }}</td>
            <td>{{ partition.nodes }}</td>
            <td>{{ partition.cpus }}</td>
        </tr>
    {% empty %}
        <tr>
            <td colspan="5">No partitions found.</td>
        </tr>
    {% endfor %}
    </tbody>
</table>

{% endblock %}

